/target

# Local Claude Code settings — machine-specific, not part of the project
.claude/settings.local.json

# Python bytecode from the benchmark harness
__pycache__/
*.pyc

# .mcp.json is UNTRACKED, not just gitignored-as-an-override.
#
# It was committed twice by accident, both times by `git add -A` sweeping up a
# local edit that added a real production endpoint. Keeping a tracked file that
# people are expected to edit locally is the trap; the only reliable fix is for
# git not to know about it at all. `.mcp.json.example` is the tracked template.
.mcp.json
.mcp.local.json
